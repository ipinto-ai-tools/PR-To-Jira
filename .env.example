# ==============================================================================
# PR-to-Jira Tool Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# Never commit the .env file - it's excluded via .gitignore

# ------------------------------------------------------------------------------
# GitHub Configuration
# ------------------------------------------------------------------------------
# Generate a token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public repos)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# Jira Configuration
# ------------------------------------------------------------------------------
# Your Jira instance URL (must include the full domain)
JIRA_BASE_URL=https://your-company.atlassian.net

# Your Jira account email address
JIRA_EMAIL=your.email@company.com

# Generate a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# ------------------------------------------------------------------------------
# Optional Configuration
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
